# Copy to .env and fill in real values for a production deployment.
# `docker compose up` works with none of this set — every variable here
# has a dev-only default baked into docker-compose.yml — but a real
# deployment should override at least POSTGRES_PASSWORD.

# Postgres credentials. The defaults ("undisputedwell"/"undisputedwell")
# are fine for local development only.
POSTGRES_USER=undisputedwell
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=undisputedwell

# Port the web (Nginx) service publishes on the host. Change if 8080 is
# already taken, or if a reverse proxy/load balancer in front of this
# stack expects a different port.
WEB_PORT=8080

# Whether the session cookie requires HTTPS (Secure attribute). Leave
# true in production — a TLS-terminating proxy/load balancer must sit in
# front of this stack (see README's production note). Only set to false
# for a local non-HTTPS override, never for a real deployment.
SESSION_COOKIE_SECURE=true
